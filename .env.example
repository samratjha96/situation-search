# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real endpoint URLs, keys, or model routes.

# Inference endpoint (OpenAI-compatible / OpenRouter-style)
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-your-key-here

# Model routes — set each role to a model your endpoint serves.
VLM_MODEL=google/gemini-2.5-flash          # frame captions
VIDEO_MODEL=google/gemini-2.5-flash        # video-native events; must accept mp4 as a `file`
                                           # content part
REASON_MODEL=google/gemini-2.5-pro         # event reasoning over commentary
OCR_MODEL=google/gemini-2.5-flash          # scorebug OCR
EMBED_MODEL=openai/text-embedding-3-small  # query + moment embeddings
RERANK_MODEL=cohere/rerank-v3.5            # cross-encoder reranker

# No-match cutoff on the reranker's score. The defaults are calibrated for
# NV-RerankQA 1B logits; a reranker that scores 0-1 (e.g. Cohere) needs its own values.
NO_MATCH_THRESHOLD=-4.0
SHOW_GAP=5.0
